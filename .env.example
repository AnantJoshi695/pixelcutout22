# PixelCutout Environment Variables
# Copy this file to .env and fill in the values as needed

# Background Removal API Configuration (for remote API engine)
# Leave blank to use the default local AI engine (@imgly/background-removal)
VITE_BACKGROUND_REMOVAL_API_URL=
VITE_BACKGROUND_REMOVAL_API_KEY=
VITE_BACKGROUND_REMOVAL_API_FIELD=image
VITE_BACKGROUND_REMOVAL_PUBLIC_PATH=

# Optional: Force specific model precision for all quality levels
# Options: isnet | isnet_fp16 | isnet_quint8 (or large | medium | small)
VITE_BACKGROUND_REMOVAL_MODEL=

# Public path for assets (usually not needed)
VITE_PUBLIC_PATH=/

# Note: VITE_ prefix is required for variables to be exposed to the client
# Only variables with VITE_ prefix will be accessible in the frontend